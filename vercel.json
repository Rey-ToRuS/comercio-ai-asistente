{
  "rewrites": [
    {
      "source": "/((?!assets/|manifest\\.json|sw\\.js|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
